    <string name="setup_recommended">Recommended. %1$s</string>
    <string name="setup_install">Install WireGuard</string>
    <string name="setup_install_summary">The official WireGuard app runs the tunnel. This app only switches it.</string>
    <string name="setup_control">Allow tunnel control</string>
    <string name="setup_control_summary">Lets this app turn WireGuard tunnels on and off.</string>
    <string name="setup_wireguard_battery">Don’t restrict WireGuard’s battery use</string>
    <string name="setup_wireguard_battery_summary">Otherwise Android stops WireGuard from turning the tunnel on in the background. In App info, open Battery and choose Unrestricted.</string>
    <string name="setup_location">Allow precise location</string>
    <string name="setup_location_summary">Android only tells apps the Wi-Fi name if they have it. The app never looks up where you are.</string>
    <string name="setup_background">Allow location all the time</string>
    <string name="setup_background_summary">So the Wi-Fi name can be read while the app is closed.</string>
    <string name="setup_location_on">Turn on location</string>
    <string name="setup_location_on_summary">Android hides Wi-Fi names while location is off.</string>
    <string name="setup_remote">Allow remote control in WireGuard</string>
    <string name="setup_remote_summary">In WireGuard, open Settings and turn on “Allow remote control apps”. Then test it.</string>
    <string name="setup_remote_needs_tunnel">In WireGuard, open Settings and turn on “Allow remote control apps”. Enter the tunnel name to test it.</string>
    <string name="setup_remote_failed">WireGuard didn’t react. Check the setting and that the tunnel name matches exactly.</string>
    <string name="setup_battery">Don’t restrict battery use</string>
    <string name="setup_battery_summary">Keeps switching reliable when the system puts unused apps to sleep.</string>

